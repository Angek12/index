DB_URL=jdbc:postgresql://localhost:5432/index_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-characters
ADMIN_EMAIL=admin@index.rw
ADMIN_PASSWORD=ChangeMe123!
CORS_ORIGINS=http://localhost:5173

# ---- New in this version (all optional) ----
# New accounts wait for admin approval. Set to false to switch that off.
REQUIRE_APPROVAL=true
# SMS alerts and reset codes through Africa's Talking
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
# WhatsApp alerts through Twilio
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_WHATSAPP_FROM=
# USSD for farmers without smartphones: callback address is /api/ussd/<this secret>
USSD_SECRET=

# ---- New in version 3 (all optional) ----
# Ask new users to confirm their phone with an SMS code. Only switch on once SMS keys work,
# or confirm phones by hand on the Users page.
REQUIRE_PHONE_VERIFICATION=false
# Shops can order directly from farmer listings
MARKETPLACE_ENABLED=true
# Farmers must enter the shop's 4-digit delivery code to mark an order delivered
REQUIRE_DELIVERY_CODE=true
